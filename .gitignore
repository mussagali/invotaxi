app/android/.gradle/
app/android/key.properties
app/ios/Pods/

# Runtime and test artifacts
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.pyc

# Local backend repository metadata retained outside the unified repo
backend/.git.backend-history/
._remote_inspect/
