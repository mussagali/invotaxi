# Secrets and local configuration
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local

# Generated dependencies and builds
frontend/node_modules/
frontend/dist/
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
