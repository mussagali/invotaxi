# --- PostgreSQL (compose service credentials) ---
POSTGRES_USER=invotaxi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=invotaxi

# --- Application ---
# Inside docker compose the hosts are service names (postgres/redis).
# For host-side runs replace them with localhost.
DATABASE_URL=postgresql+asyncpg://invotaxi:change-me-strong-password@postgres:5432/invotaxi
REDIS_URL=redis://redis:6379/0

# openssl rand -hex 32
SECRET_KEY=change-me-64-hex-chars

ENV=dev
LOG_LEVEL=INFO
FCM_SERVER_KEY=
REPORTS_DIR=/data/reports
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Local frontend/app bootstrap only. Keep disabled in production.
DEV_AUTO_REGISTER=false
DEV_APP_PASSWORD=
VITE_ALLOW_DEV_LOGIN=false
VITE_YANDEX_MAPS_API_KEY=
VITE_YANDEX_MAPS_SUGGEST_API_KEY=
VITE_LEGAL_CONTACT_EMAIL=support@invotaxi.kz

# --- Dev seed (scripts/seed_dev.py) ---
SEED_ADMIN_PASSWORD=change-me-admin
SEED_USER_PASSWORD=change-me-user

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- Production process sizing ---
API_WORKERS=2
API_REPLICAS=1
WORKER_REPLICAS=1
