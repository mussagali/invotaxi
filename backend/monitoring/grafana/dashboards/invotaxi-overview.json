{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (handler) (rate(http_requests_total[1m]))", "legendFormat": "{{handler}}", "refId": "A"}],
      "title": "API RPS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "all p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{handler}} p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "all p99", "refId": "C"}
      ],
      "title": "API latency p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(invotaxi_websocket_connections)", "legendFormat": "active", "refId": "A"}],
      "title": "WebSocket connections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 8},
      "id": 4,
      "targets": [
        {"expr": "sum(rate(invotaxi_gps_points_total{result=\"accepted\"}[1m]))", "legendFormat": "accepted", "refId": "A"},
        {"expr": "sum(rate(invotaxi_gps_anomalies_dropped_total[1m]))", "legendFormat": "anomalies", "refId": "B"}
      ],
      "title": "GPS points / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 8},
      "id": 5,
      "targets": [{"expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"api|worker|postgres|redis\"}[1m]))", "legendFormat": "{{container_label_com_docker_compose_service}}", "refId": "A"}],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 8},
      "id": 6,
      "targets": [{"expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service=~\"api|worker|postgres|redis\"})", "legendFormat": "{{container_label_com_docker_compose_service}}", "refId": "A"}],
      "title": "Container RAM",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 15},
      "id": 7,
      "targets": [{"expr": "sum(pg_stat_database_numbackends{datname!~\"template.*\"})", "legendFormat": "connections", "refId": "A"}],
      "title": "PostgreSQL connections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 15},
      "id": 8,
      "targets": [{"expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "ops/s", "refId": "A"}],
      "title": "Redis operations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 4, "x": 16, "y": 15},
      "id": 9,
      "targets": [{"expr": "invotaxi_arq_queue_size", "legendFormat": "queued", "refId": "A"}],
      "title": "ARQ queue",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 4, "x": 20, "y": 15},
      "id": 10,
      "targets": [{"expr": "max(invotaxi_dispatch_job_last_duration_seconds)", "legendFormat": "last", "refId": "A"}],
      "title": "Dispatch duration",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["invotaxi", "p9"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "InvoTaxi P9 Overview",
  "uid": "invotaxi-p9",
